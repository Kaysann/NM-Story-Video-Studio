{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmsvs.local/schemas/reels/v1.json",
  "title": "Paramètres et sélection humaine des Reels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selection"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "params": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "durations": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 5, "maximum": 180 } },
        "count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxOverlap": { "type": "number", "minimum": 0, "maximum": 1 },
        "lambda": { "type": "number", "minimum": 0, "maximum": 1 },
        "timeline": { "$ref": "../common/v1.json#/$defs/relPath", "description": "Timeline déclarative propre aux Shorts (défaut : timeline.json du clip)" },
        "closing": {
          "type": "object", "additionalProperties": false, "required": ["scene"],
          "description": "Fermeture ajoutée après la musique : paroles masquées, transition vers le 1er plan de la scène, tenue",
          "properties": {
            "scene": { "type": "string", "minLength": 1 },
            "transition": { "type": "object", "additionalProperties": false, "properties": {
              "type": { "enum": ["page-turn", "crossfade"] }, "duration": { "type": "object", "additionalProperties": false, "required": ["sec"], "properties": { "sec": { "type": "number", "minimum": 0.2, "maximum": 4 } } },
              "direction": { "enum": ["left", "right"] } } },
            "lyricsOutSec": { "type": "number", "minimum": 0, "maximum": 2 },
            "holdSec": { "type": "number", "minimum": 0, "maximum": 5 },
            "audio": { "enum": ["stop", "continue"], "description": "stop (défaut) : silence après la musique ; continue : le master se poursuit sous la fermeture, fondu audio sur les dernières images (aucun fondu image)" }
          }
        },
        "syncOverrides": { "$ref": "../common/v1.json#/$defs/relPath", "description": "Corrections de synchronisation propres aux Shorts (même schéma que sync.overrides.json), appliquées par-dessus celles du clip ; jamais utilisées par le clip" },
        "weights": {
          "oneOf": [
            { "$ref": "../common/v1.json#/$defs/presetRef" },
            { "type": "object", "propertyNames": { "enum": ["hook", "energy", "lift", "vocal", "completeness", "lyric", "loopability", "uniqueness"] }, "additionalProperties": { "type": "number", "minimum": 0 } }
          ]
        }
      }
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["candidate"],
        "properties": {
          "candidate": { "type": "string", "pattern": "^cand-[0-9]+$" },
          "name": { "$ref": "../common/v1.json#/$defs/id" },
          "adjust": {
            "type": "object", "additionalProperties": false,
            "properties": { "startSec": { "type": "number" }, "endSec": { "type": "number" } }
          },
          "snap": { "type": "boolean" }
        }
      }
    }
  }
}

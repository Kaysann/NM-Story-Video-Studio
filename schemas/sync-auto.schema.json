{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmsvs.local/schemas/sync-auto/v1.json",
  "title": "Synchronisation automatique / résolue (fichiers machine)",
  "type": "object",
  "required": ["version", "engine", "audioSha256", "lines"],
  "$defs": {
    "source": { "enum": ["auto", "override", "interpolated", "uniform"] },
    "word": {
      "type": "object", "required": ["id", "text", "start", "end", "confidence", "source"],
      "properties": {
        "id": { "$ref": "../common/v1.json#/$defs/wordId" }, "text": { "type": "string" },
        "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "$ref": "#/$defs/source" }
      }
    },
    "line": {
      "type": "object", "required": ["id", "start", "end", "confidence", "source", "words"],
      "properties": {
        "id": { "$ref": "../common/v1.json#/$defs/lineId" },
        "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "source": { "$ref": "#/$defs/source" },
        "words": { "type": "array", "items": { "$ref": "#/$defs/word" } }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "engine": { "type": "string" },
    "audioSha256": { "$ref": "../common/v1.json#/$defs/sha256" },
    "lyricsHash": { "type": "string" },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
    "sections": { "type": "object" },
    "staleOverrides": { "type": "array", "items": { "type": "string" } },
    "textDiff": { "type": "array" },
    "metrics": { "type": "object" }
  }
}

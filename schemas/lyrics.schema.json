{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmsvs.local/schemas/lyrics/v1.json",
  "title": "Structure des paroles (fichier humain)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "language", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "title": { "type": "string" },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "lines"],
        "properties": {
          "id": { "$ref": "../common/v1.json#/$defs/id" },
          "kind": { "enum": ["intro", "verse", "prechorus", "chorus", "bridge", "outro", "instrumental", "spoken", "other"] },
          "label": { "type": "string" },
          "repeatOf": { "oneOf": [{ "$ref": "../common/v1.json#/$defs/id" }, { "type": "null" }] },
          "style": { "$ref": "../common/v1.json#/$defs/lyricsStyleRef" },
          "lines": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "text"],
              "properties": {
                "id": { "$ref": "../common/v1.json#/$defs/lineId" },
                "text": { "type": "string", "minLength": 1 },
                "display": {
                  "type": "object", "propertyNames": { "$ref": "../common/v1.json#/$defs/formatId" },
                  "additionalProperties": { "type": "string", "minLength": 1 }
                },
                "singer": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "skipAlign": { "type": "boolean" },
                "style": { "$ref": "../common/v1.json#/$defs/lyricsStyleRef" }
              }
            }
          }
        }
      }
    }
  }
}

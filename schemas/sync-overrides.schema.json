{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmsvs.local/schemas/sync-overrides/v1.json",
  "title": "Corrections humaines de synchronisation (jamais écrasées par un recalcul)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "globalOffsetSec": { "type": "number", "minimum": -5, "maximum": 5 },
    "lines": {
      "type": "object", "propertyNames": { "$ref": "../common/v1.json#/$defs/lineId" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 },
          "shift": { "type": "number", "minimum": -30, "maximum": 30 },
          "lock": { "type": "boolean" }, "note": { "type": "string" }
        }
      }
    },
    "words": {
      "type": "object", "propertyNames": { "$ref": "../common/v1.json#/$defs/wordId" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": { "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 }, "lock": { "type": "boolean" } }
      }
    }
  }
}
